# Copy this file to benchmark/candidates.env.
# For the first x86 VM smoke test, the Qwen path below matches the recommended
# `/models/qwen3-4b/` layout and the Phi fields can stay empty.

QWEN_LABEL=qwen3_4b_q4km
QWEN_MODEL=/models/qwen3-4b/Qwen3-4B-Instruct-Q4_K_M.gguf
QWEN_PORT=8081

# Leave Phi blank for the one-model smoke run. Fill these in later for the pair benchmark.
PHI_LABEL=
PHI_MODEL=
PHI_PORT=8082

# For the next side-by-side bake-off, replace the blank Phi values above with:
# PHI_LABEL=phi4_mini_q4km
# PHI_MODEL=/models/phi4-mini/Phi-4-mini-instruct-Q4_K_M.gguf

# Shared runner knobs
THREADS=4
THREADS_BATCH=4
CTX_SIZE=2048
BATCH_SIZE=2048
UBATCH_SIZE=512
REPETITIONS=5
